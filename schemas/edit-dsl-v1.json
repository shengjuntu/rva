{
  "type": "object",
  "properties": {
    "version": {
      "const": 1
    },
    "canvas": {
      "type": "object",
      "properties": {
        "width": {
          "anyOf": [
            {
              "const": 0
            },
            {
              "type": "integer",
              "minimum": 32,
              "maximum": 3840,
              "multipleOf": 2
            }
          ]
        },
        "height": {
          "anyOf": [
            {
              "const": 0
            },
            {
              "type": "integer",
              "minimum": 32,
              "maximum": 3840,
              "multipleOf": 2
            }
          ]
        },
        "fps": {
          "anyOf": [
            {
              "const": 0
            },
            {
              "type": "integer",
              "minimum": 1,
              "maximum": 60
            }
          ]
        },
        "background": {
          "type": "string",
          "pattern": "^#[0-9a-fA-F]{6}$"
        },
        "duration": {
          "type": "number",
          "minimum": 0,
          "maximum": 600
        }
      },
      "required": [],
      "additionalProperties": false
    },
    "tracks": {
      "type": "array",
      "minItems": 1,
      "maxItems": 20,
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_.-]{0,63}$"
          },
          "kind": {
            "enum": [
              "video",
              "audio",
              "text"
            ]
          },
          "name": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "kind"
        ],
        "additionalProperties": false
      }
    },
    "anchors": {
      "type": "array",
      "maxItems": 300,
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_.-]{0,63}$"
          },
          "time": {
            "type": "number",
            "minimum": 0,
            "maximum": 600
          },
          "clip": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_.-]{0,63}$"
          },
          "edge": {
            "enum": [
              "start",
              "end"
            ]
          },
          "offset": {
            "type": "number"
          }
        },
        "required": [
          "id"
        ],
        "additionalProperties": false,
        "oneOf": [
          {
            "required": [
              "time"
            ],
            "not": {
              "required": [
                "clip"
              ]
            }
          },
          {
            "required": [
              "clip"
            ],
            "not": {
              "required": [
                "time"
              ]
            }
          }
        ]
      }
    },
    "clips": {
      "type": "array",
      "minItems": 1,
      "maxItems": 240,
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_.-]{0,63}$"
          },
          "track": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_.-]{0,63}$"
          },
          "asset": {
            "type": "string"
          },
          "start": {
            "type": "number",
            "minimum": 0,
            "maximum": 600
          },
          "after": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_.-]{0,63}$"
          },
          "anchor": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_.-]{0,63}$"
          },
          "offset": {
            "type": "number"
          },
          "duration": {
            "type": "number",
            "minimum": 0,
            "maximum": 600
          },
          "source": {
            "type": "object",
            "properties": {
              "in": {
                "type": "number",
                "minimum": 0,
                "maximum": 86400
              },
              "out": {
                "type": "number",
                "exclusiveMinimum": 0,
                "maximum": 86400
              },
              "speed": {
                "anyOf": [
                  {
                    "const": 0
                  },
                  {
                    "type": "number",
                    "minimum": 0.5,
                    "maximum": 2
                  }
                ]
              }
            },
            "required": [],
            "additionalProperties": false
          },
          "layout": {
            "type": "object",
            "properties": {
              "x": {
                "type": "integer"
              },
              "y": {
                "type": "integer"
              },
              "width": {
                "type": "integer",
                "minimum": 0
              },
              "height": {
                "type": "integer",
                "minimum": 0
              },
              "fit": {
                "enum": [
                  "cover",
                  "contain"
                ]
              },
              "opacity": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              }
            },
            "required": [],
            "additionalProperties": false
          },
          "text": {
            "type": "string",
            "maxLength": 4000
          },
          "fontSize": {
            "anyOf": [
              {
                "const": 0
              },
              {
                "type": "integer",
                "minimum": 8,
                "maximum": 240
              }
            ]
          },
          "color": {
            "type": "string",
            "pattern": "^#[0-9a-fA-F]{6}$"
          },
          "volume": {
            "type": "number",
            "minimum": 0,
            "maximum": 2
          },
          "fadeIn": {
            "type": "number",
            "minimum": 0,
            "maximum": 600
          },
          "fadeOut": {
            "type": "number",
            "minimum": 0,
            "maximum": 600
          }
        },
        "required": [
          "id",
          "track"
        ],
        "additionalProperties": false,
        "oneOf": [
          {
            "required": [
              "start"
            ],
            "not": {
              "anyOf": [
                {
                  "required": [
                    "after"
                  ]
                },
                {
                  "required": [
                    "anchor"
                  ]
                }
              ]
            }
          },
          {
            "required": [
              "after"
            ],
            "not": {
              "anyOf": [
                {
                  "required": [
                    "start"
                  ]
                },
                {
                  "required": [
                    "anchor"
                  ]
                }
              ]
            }
          },
          {
            "required": [
              "anchor"
            ],
            "not": {
              "anyOf": [
                {
                  "required": [
                    "start"
                  ]
                },
                {
                  "required": [
                    "after"
                  ]
                }
              ]
            }
          }
        ]
      }
    }
  },
  "required": [
    "version",
    "canvas",
    "tracks",
    "clips"
  ],
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "video-edit-dsl-v1",
  "title": "Video editing DSL v1",
  "description": "Structural contract. Cross references, media types, time cycles, source consistency and kind-specific fields are additionally checked by the compiler. Zero numeric defaults mean automatic defaults, not a frozen clip."
}