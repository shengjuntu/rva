# scripts/docker.sh init writes UID/GID, a persistent absolute data path and this config.
VIDEO_IMAGE=rundesk-video-app:0.25.0
VIDEO_UID=1000
VIDEO_GID=1000
VIDEO_HOST_DATA=../.state/video
VIDEO_LISTEN=0.0.0.0:3220
VIDEO_APP_PUBLIC_URL=http://127.0.0.1:3220
VIDEO_APP_MCP_URL=http://host.docker.internal:3220/api/mcp
RUNDESK_URL=http://127.0.0.1:3210
RUNDESK_TOKEN=
# Optional RunDesk-approved preset for NEW projects; blank preserves legacy default.
# Existing projects keep their recorded environment. Requires RunDesk 0.50.0.
# VIDEO_PRODUCTION_PROFILE=hyperframes
# Optional video_use preset shared roots, keyed by exact RunDesk workspace ID.
# Mount each corresponding workspace at a separate path in a custom overlay.
# VIDEO_EXCHANGE_ROOTS={"RUNDESK_WORKSPACE_ID":"/exchanges/video-use"}
VIDEO_CPUS=4
VIDEO_MEMORY=4g

# Optional: leave all VIDEO_TTS_* unset/empty to configure TTS in the WebUI.
# Setting any nonempty value makes speech settings managed by environment.
# VIDEO_TTS_BACKEND=indextts
# VIDEO_TTS_URL=http://127.0.0.1:8092/v1/audio/speech
# VIDEO_TTS_MODEL=IndexTeam/IndexTTS-2.5
# VIDEO_TTS_VOICE=news_zh
# VIDEO_TTS_LANGUAGE=zh
# VIDEO_TTS_TIMEOUT_SECONDS=180
# VIDEO_TTS_API_KEY=

# Optional generation services (restart App after changing).
# Generic images/video: http_binary_v1 endpoints returning raw PNG/JPEG/MP4.
# VIDEO_IMAGE_GEN_URL=http://127.0.0.1:8080/image
# VIDEO_IMAGE_GEN_MODEL=your-image-model
# VIDEO_IMAGE_GEN_KEY=
# Built-in ComfyUI MiniMax-H3 text-to-video (models/nodes already installed).
# VIDEO_VIDEO_GEN_URL=comfy://127.0.0.1:19897
# VIDEO_VIDEO_GEN_MODEL=minimax_h3_fl2va
# VIDEO_VIDEO_GEN_KEY=
# Preserve the H3 quiet-audio fix; 0 keeps original audio bytes. Range: -30..30.
# VIDEO_COMFY_H3_AUDIO_GAIN_DB=18
