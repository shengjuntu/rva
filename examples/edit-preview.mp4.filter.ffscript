color=c=black@0:s=220x60:r=30:d=2.000000,format=rgba,drawtext=fontfile=font.ttf:textfile=text_4.txt:expansion=none:fontcolor=0xffffff:fontsize=18:x=0:y=0,fade=t=in:st=0:d=0.100000:alpha=1,fade=t=out:st=1.900000:d=0.100000:alpha=1,setpts=PTS-STARTPTS+0.000000/TB[clip4];
[5:a]asetpts=PTS-STARTPTS,atempo=1.000000,aresample=48000,aformat=sample_fmts=fltp:channel_layouts=stereo,asettb=1/48000,asetpts=N/SR/TB,atrim=duration=1.000000,volume=0.500000,afade=t=in:st=0:d=0.050000,afade=t=out:st=0.950000:d=0.050000,adelay=500|500,asetpts=N/SR/TB[clip5];
